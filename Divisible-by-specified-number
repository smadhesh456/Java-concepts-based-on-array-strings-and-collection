import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int c = 0;
        int sum = 0;
        int arr[] = new int[n];
        for (int i = 0; i<n; i++){
            arr[i]= sc.nextInt();
        }
        int num = sc.nextInt();
        System.out.print("The elements that are divisible by "+num+" is ");
        for(int i = 0; i<n; i++){
            
            if(arr[i]%num == 0){
                System.out.print(arr[i]+" ");
                c++;
                sum = sum+arr[i];
            }
        
        }
        System.out.println();
        System.out.println("The Count of the value that is divisible by "+num+" is "+c);
        System.out.print("The Sum of value that is divisible by "+num+" is "+sum);
    }
}
