import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        System.out.println("Enter a number");
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        System.out.println(n);
        int c = 0;
        while(n>0){ 
        if(n%2==0){
            n = n / 2;
            System.out.println(n);
            c++;
            if(n==1){
                System.out.print("count:"+c);
                break;
            }
        }
        else if(n%2!=0){
            n=3*n+1;
            System.out.println(n);
            c++;
            if(n==1){
                System.out.print("count:"+c);
                break;
            }
        }
        }
        
    }
}
